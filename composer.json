{
	"name": "nette/database",
	"description": "💾 Nette Database: a database layer with SQL and smart placeholders, plus Explorer, which follows table relations without joins or N+1 queries and fetches only the columns you use.",
	"keywords": ["nette", "database", "dbal", "sql", "query builder", "active record", "pdo", "mysql", "postgresql", "sqlite", "mssql", "oracle"],
	"homepage": "https://doc.nette.org/database",
	"license": ["BSD-3-Clause", "GPL-2.0-only", "GPL-3.0-only"],
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": "8.1 - 8.6",
		"ext-pdo": "*",
		"nette/caching": "^3.2",
		"nette/utils": "^4.0"
	},
	"require-dev": {
		"nette/tester": "^2.6",
		"nette/di": "^3.1",
		"mockery/mockery": "^1.6@stable",
		"tracy/tracy": "^2.9",
		"phpstan/phpstan": "^2.3@stable",
		"phpstan/extension-installer": "^1.4@stable",
		"nette/phpstan-rules": "^1.0.5",
		"jetbrains/phpstorm-attributes": "^1.2"
	},
	"autoload": {
		"classmap": ["src/"],
		"psr-4": {
			"Nette\\": "src"
		}
	},
	"minimum-stability": "dev",
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "3.2-dev"
		}
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	}
}
