use:
	- nette
	- modernizations

typeAnalysis: phpstan

paths:
	- src
	- tests

fileExtensions:
	- php
	- phpt

imports: {grouping: {class: grouped}}

overrides:
	-
		paths: [src]
		nameResolution: certain
		use:
			- compilerOptimizations
			- deprecations

	- # the deprecated factory methods are kept implemented and called for backward compatibility
		paths: [src/Database/ResultSet.php, src/Database/Row.php, src/Database/Table]
		upgrading: {declarations: {deprecatedMember: keep}}

	- # the names of the ArrayAccess parameters say what the offset is, renaming them breaks calls naming them
		paths: [src/Database/Table/ActiveRow.php, src/Database/Table/Selection.php]
		classes: {overridingMethod: {parameterName: keep}}

	- # the mock makes the protected methods public
		paths: ['tests/Database/Explorer/SqlBuilder.parseJoinConditions().phpt']
		classes: {overridingMethod: {parentCallOnly: keep}}
